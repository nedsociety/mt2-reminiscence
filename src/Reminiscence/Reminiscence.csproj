<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Reminiscence</AssemblyName>
    <Product>Monster Train: Reminiscence</Product>
    <Version>0.0.1</Version>
    <Description>Monster Train 1 field and boss music for Monster Train 2.</Description>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" IncludeAssets="compile" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" />
  </ItemGroup>

  <!-- Debug drops go in the Proton MT2 install. MT2_ROOT is set by the devcontainer. -->
  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(MT2_ROOT)' != '' and Exists('$(MT2_ROOT)/BepInEx/plugins')">
    <ItemGroup>
      <PluginOutput Include="$(TargetPath)" />
      <PluginOutput Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginOutput)" DestinationFolder="$(MT2_ROOT)/BepInEx/plugins" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied @(PluginOutput->'%(Filename)%(Extension)', ', ') to $(MT2_ROOT)/BepInEx/plugins" />
  </Target>

</Project>
