{
  "version": 1,
    "playback": {
    "loop": "CoreAudioSystem sets AudioSource.loop on every music clip. No music FSB5 header contains a LOOP chunk, so each loop window is the whole clip, from sample 0 through the sample count.",
    "layers": "Field tracks start a distinct base clip and high clip on the same frame, then crossfade by transitioning the BattleMusic mixer to the Base or High snapshot. Boss tracks assign one clip to both mixer groups and define no snapshots.",
    "lengthDeltaSamples": "Longest layer sample count minus shortest, when every layer shares a sample rate. Null when they do not."
  },
